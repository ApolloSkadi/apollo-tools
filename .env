# ============================================================
# Apollo Tools 环境变量（Taro 多环境）
#
# 命名规则：必须使用 TARO_APP_ 前缀，构建时注入 process.env。
#   .env                所有环境的默认值
#   .env.development    taro build --watch（开发）覆盖
#   .env.production     taro build（发布）覆盖
#
# 发布前只需修改 .env.production 中的 TARO_APP_API_BASE_URL
# 为已备案的 HTTPS 域名，并在小程序后台配置 request 合法域名。
# ============================================================

# 后端接口主地址（apollo-miniweb/server，根路径 /api/v1）
# TARO_APP_API_BASE_URL=https://api.followupsystem.online/api/v1
TARO_APP_API_BASE_URL=http://localhost:8080/api/v1

# 是否使用本地 Mock（true 时完全不发网络请求）
TARO_APP_USE_MOCK=false
